{
  "name": "p2p-media-loader-core",
  "description": "P2P Media Loader core functionality",
  "license": "Apache-2.0",
  "author": "Novage",
  "homepage": "https://github.com/Novage/p2p-media-loader",
  "repository": {
    "type": "git",
    "url": "https://github.com/Novage/p2p-media-loader",
    "directory": "packages/p2p-media-loader-core"
  },
  "keywords": [
    "p2p",
    "peer-to-peer",
    "hls",
    "dash",
    "webrtc",
    "video",
    "mse",
    "player",
    "torrent",
    "bittorrent",
    "webtorrent",
    "hlsjs",
    "shaka player",
    "ecdn",
    "cdn"
  ],
  "version": "5.0.0",
  "files": [
    "dist",
    "lib",
    "src"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./hls": "./src/hls.ts",
    "./dash": "./src/dash.ts",
    "./server": "./src/server.ts"
  },
  "types": "./src/index.ts",
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./lib/index.d.ts",
        "p2pml:core-as-bundle": "./dist/p2p-media-loader-core.es.js",
        "import": "./lib/index.js"
      },
      "./hls": {
        "types": "./lib/hls.d.ts",
        "import": "./lib/hls.js"
      },
      "./dash": {
        "types": "./lib/dash.d.ts",
        "import": "./lib/dash.js"
      },
      "./server": {
        "types": "./lib/server.d.ts",
        "import": "./lib/server.js"
      }
    },
    "types": "./lib/index.d.ts"
  },
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "rimraf lib build && pnpm build:es && pnpm build:esm && pnpm build:esm-min",
    "build:esm": "vite build --mode esm && vite build --mode esm-hls && vite build --mode esm-dash",
    "build:esm-min": "vite build --mode esm-min && vite build --mode esm-hls-min && vite build --mode esm-dash-min",
    "build:es": "tsc && cp src/manifest/vendor-types.d.ts lib/manifest/vendor-types.d.ts",
    "prettier": "prettier --write .",
    "lint": "eslint src --report-unused-disable-directives --max-warnings 0 --flag unstable_native_nodejs_ts_config",
    "clean:build": "rimraf lib dist build p2p-media-loader-core-*.tgz",
    "type-check": "npx tsc --noEmit",
    "test": "vitest",
    "test:ci": "vitest run"
  },
  "dependencies": {
    "@types/debug": "^4.1.13",
    "@videojs/vhs-utils": "^4.1.2",
    "debug": "^4.4.3",
    "m3u8-parser": "^7.2.0",
    "mpd-parser": "^1.4.0"
  },
  "devDependencies": {
    "vitest": "^5.0.0"
  }
}
